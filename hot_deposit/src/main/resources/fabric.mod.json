	"authors": [
		"tbenassi"
	],
	"contact": {
		"email": "tjbenassi@gmail.com"
	},
	"license": "CC0-1.0",
	"icon": "assets/hot-deposit/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"io.github.tbenassi.com.hotdeposit.client.HotDepositClient"
		]
	},
	"mixins": [
		"hot_deposit.mixins.json"
	],
	"depends": {
		"minecraft": ">=1.21.11",
		"fabricloader": ">=0.18.4",
		"fabric-api": "*",
		"java": ">=21"
	},
	"suggests": {}
}